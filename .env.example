DATABASE_URL=                       # the Core bot's Postgres, read-only user; blank = demo data
CORE_VISIBLE_CHAT_IDS=              # comma-separated Telegram chat IDs the app may show, e.g. -1001234567890
ARCADE_API_KEY=                     # refreshes product images and reads order status
ARCADE_API_BASE=https://platform.arcade.ai/v1
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=  # bot username without @, for "Get yours" links
